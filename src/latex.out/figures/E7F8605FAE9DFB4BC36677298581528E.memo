\begin {tikzpicture}[>=stealth, thick] \par \draw [line width=2pt] (0,-1.5) -- (0,1.5); \draw [line width=2pt] (4,-1.5) -- (4,1.5); \par \node [left] at (0,0) {Cathode}; \node [right] at (4,0) {Anode}; \par \node [below] at (0,-1.5) {$V(0)=0$}; \node [below] at (4,-1.5) {$V(d)=V_0$}; \par \draw [fill=white] (1.8,0) circle (0.12); \node at (1.8,0.12) {$-$}; \par \draw [->] (2.05,0) -- (3.5,0) node[midway, above] {$v$}; \par \draw [<->] (0,-2) -- (4,-2) node[midway, below] {$d$}; \par \end {tikzpicture}
