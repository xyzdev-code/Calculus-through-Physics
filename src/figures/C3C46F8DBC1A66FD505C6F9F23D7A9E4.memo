\begin {tikzpicture} \draw [step=1cm,gray,very thin] (-3.9,-3.9) grid (3.9,3.9); \draw [thick,->] (-4,0) -- (4,0) node[anchor=north west] {x}; \draw [thick,->] (0,-4) -- (0,4) node[anchor=south east] {y}; \foreach \x in {-3,-2,-1,1,2,3} \draw (\x ,1pt) -- (\x ,-3pt) node[anchor=north] {\x }; \foreach \y in {-3,-2,-1,1,2,3} \draw (1pt,\y ) -- (-3pt,\y ) node[anchor=east] {\y }; \foreach \x in {-3,-2,-1,0,1,2,3} { \foreach \y in {-3,-2,-1,0,1,2,3} { \fill (\x ,\y ) circle (2pt); } } \end {tikzpicture}
